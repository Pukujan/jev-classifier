@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix jcc:  <https://github.com/Pukujan/jev-classifier/ontology/claims#> .

# Lean OWL2 skeleton for jev-classifier claims.
# PROV-O alignment uses rdfs:subClassOf / rdfs:subPropertyOf plus rdfs:seeAlso;
# the handful of prov: terms we lean on are declared locally so the offline
# syntax check needs no remote owl:imports fetch.
#
# The JEV call is modelled as an activity: a jcc:Claim is a prov:Entity
# generated by a jcc:ClassificationActivity, which was associated with a
# jcc:ClassifierAgent and used the jcc:SourceFragment as evidence. The model id
# belongs to the activity/agent, not to the produced claim.

<https://github.com/Pukujan/jev-classifier/ontology/claims>
    a owl:Ontology ;
    rdfs:label "jev-classifier claims ontology" ;
    rdfs:comment "Claim + SourceFragment with epistemic status and bitemporal hooks (valid time + transaction time), plus the ClassificationActivity/ClassifierAgent that produced each claim. Aligns leanly with PROV-O Entity/Activity/SoftwareAgent patterns and PCM-0050-compatible field names." ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#> .

##############################################################################
# PROV-O terms used locally (declared, not owl:imports; seeAlso only)
##############################################################################

prov:Entity a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Entity> .

prov:Activity a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Activity> .

prov:Agent a owl:Class ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#Agent> .

prov:SoftwareAgent a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#SoftwareAgent> .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#wasGeneratedBy> .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Agent ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#wasAssociatedWith> .

prov:used a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#used> .

prov:wasRevisionOf a owl:ObjectProperty ;
    rdfs:seeAlso <http://www.w3.org/ns/prov#wasRevisionOf> .

##############################################################################
# Classes
##############################################################################

jcc:Claim a owl:Class ;
    rdfs:label "Claim" ;
    rdfs:comment "A classified assertion derived from a SourceFragment. A PROV Entity, generated by a jcc:ClassificationActivity (prov:wasGeneratedBy)." ;
    rdfs:subClassOf prov:Entity .

jcc:SourceFragment a owl:Class ;
    rdfs:label "SourceFragment" ;
    rdfs:comment "A bounded excerpt of a transcript or paper used as evidence. A PROV Entity; a classification activity consumes it via prov:used." ;
    rdfs:subClassOf prov:Entity .

jcc:ClassificationActivity a owl:Class ;
    rdfs:label "ClassificationActivity" ;
    rdfs:comment "The JEV classification call that produced a Claim. Associated with one jcc:ClassifierAgent (prov:wasAssociatedWith) and consumes the SourceFragment (prov:used). Carries the provider-surfaced model id." ;
    rdfs:subClassOf prov:Activity .

jcc:ClassifierAgent a owl:Class ;
    rdfs:label "ClassifierAgent" ;
    rdfs:comment "The software agent that performed a classification: the pinned JEV model as invoked through the OpenRouter Decisions API. Carries the requested model id." ;
    rdfs:subClassOf prov:SoftwareAgent .

jcc:EpistemicStatus a owl:Class ;
    rdfs:label "EpistemicStatus" ;
    rdfs:comment "Closed vocabulary for how an assertion was obtained (Observed, Inferred, Hypothesized, etc.). Domain extension over PROV; not a truth bit." .

##############################################################################
# Individuals (lean closed set for epistemic status)
##############################################################################

jcc:Observed a jcc:EpistemicStatus ;
    rdfs:label "Observed" ;
    rdfs:comment "Directly grounded in source evidence without substantial inference." .

jcc:Inferred a jcc:EpistemicStatus ;
    rdfs:label "Inferred" ;
    rdfs:comment "Derived via JEV judgment and/or local aggregation over evidence." .

jcc:Hypothesized a jcc:EpistemicStatus ;
    rdfs:label "Hypothesized" ;
    rdfs:comment "Tentative; pending review or further evidence." .

##############################################################################
# Properties — epistemic + bitemporal + lineage + provenance edges
##############################################################################

jcc:epistemicStatus a owl:ObjectProperty ;
    rdfs:label "epistemicStatus" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( jcc:Claim jcc:SourceFragment ) ] ;
    rdfs:range jcc:EpistemicStatus ;
    rdfs:comment "PCM-compatible: epistemic_status. How the assertion was established. Domain widened so a SourceFragment can be graded, not only a Claim." .

jcc:labelValue a owl:DatatypeProperty ;
    rdfs:label "labelValue" ;
    rdfs:domain jcc:Claim ;
    rdfs:range xsd:string ;
    rdfs:comment "Closed-set classifier label string (validated in application code)." .

jcc:validFrom a owl:DatatypeProperty ;
    rdfs:label "validFrom" ;
    rdfs:domain jcc:Claim ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Valid-time start: when the claim is considered true in the world (PCM valid_from). Domain extension: PROV-O defines no valid-time construct." .

jcc:validTo a owl:DatatypeProperty ;
    rdfs:label "validTo" ;
    rdfs:domain jcc:Claim ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Valid-time end (exclusive or inclusive per adopter); omit if still current." .

jcc:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recordedAt" ;
    rdfs:domain jcc:Claim ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Transaction time: when this claim record was written (PCM recorded_at)." .

jcc:supersedes a owl:ObjectProperty , owl:IrreflexiveObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:subPropertyOf prov:wasRevisionOf ;
    rdfs:domain jcc:Claim ;
    rdfs:range jcc:Claim ;
    rdfs:seeAlso <http://purl.org/nanopub/x/supersedes> ;
    rdfs:comment "Lineage: this claim replaces a prior claim. Aligns with PCM supersedes, with prov:wasRevisionOf, and with npx:supersedes (which declares owl:IrreflexiveObjectProperty)." .

jcc:evidence a owl:ObjectProperty ;
    rdfs:label "evidence" ;
    rdfs:domain jcc:Claim ;
    rdfs:range jcc:SourceFragment ;
    rdfs:comment "Pointer to the SourceFragment that grounded the classification. The activity-level counterpart is prov:used." .

jcc:modelId a owl:DatatypeProperty ;
    rdfs:label "modelId" ;
    rdfs:domain jcc:ClassifierAgent ;
    rdfs:range xsd:string ;
    rdfs:comment "Requested JEV model id (e.g. typesafe/jev-1.13). Belongs to the agent that made the call, not to the produced Claim." .

jcc:surfacedModelId a owl:DatatypeProperty ;
    rdfs:label "surfacedModelId" ;
    rdfs:domain jcc:ClassificationActivity ;
    rdfs:range xsd:string ;
    rdfs:comment "Provider-surfaced model id for this call, when the provider returns one. May differ from the requested jcc:modelId; never fabricated when absent." .

jcc:fragmentText a owl:DatatypeProperty ;
    rdfs:label "fragmentText" ;
    rdfs:domain jcc:SourceFragment ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal text of the fragment (fixtures may keep this short)." .

jcc:independenceClass a owl:DatatypeProperty ;
    rdfs:label "independenceClass" ;
    rdfs:domain jcc:Claim ;
    rdfs:range xsd:string ;
    rdfs:comment "PCM-compatible: independence_class. How independently this claim was obtained (e.g. single-run, multi-run, cross-source)." .
