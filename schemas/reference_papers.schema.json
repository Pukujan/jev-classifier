{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/jev-classifier/schemas/reference_papers.schema.json",
  "title": "JEV reference-paper candidate manifest",
  "description": "Bibliographic and access metadata for the selected candidate papers. It contains no paper text, annotations, or train/holdout assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "checked_at",
    "selection_method",
    "intended_use",
    "source_checkpoints",
    "papers",
    "excluded_candidates",
    "rights_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"const": "jev-reference-papers-v1"},
    "status": {"const": "selected_candidates_not_annotated"},
    "checked_at": {"type": "string", "format": "date"},
    "selection_method": {"type": "string", "minLength": 40, "maxLength": 1400},
    "intended_use": {"type": "string", "minLength": 40, "maxLength": 1000},
    "source_checkpoints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/checkpoint"}
    },
    "papers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/paper"}
    },
    "excluded_candidates": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/excludedCandidate"}
    },
    "rights_boundary": {"type": "string", "minLength": 40, "maxLength": 1400}
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_id", "url", "purpose"],
      "properties": {
        "comment_id": {"type": "string", "pattern": "^\\d+$"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "purpose": {"type": "string", "minLength": 10, "maxLength": 240}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "name", "applies_to", "evidence_urls", "notes"],
      "properties": {
        "status": {"enum": ["confirmed_for_selected_version", "partial_version_scope", "unconfirmed"]},
        "name": {"type": ["string", "null"]},
        "applies_to": {"type": "string", "minLength": 8, "maxLength": 240},
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/httpsUrl"}
        },
        "notes": {"type": "string", "minLength": 10, "maxLength": 700}
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "title",
        "authors",
        "venue",
        "publication_year",
        "publication_details",
        "doi",
        "canonical_record_url",
        "selected_text_version",
        "full_text_url",
        "access_status",
        "license",
        "topics",
        "selection_rationale",
        "scope_limit",
        "checked_at"
      ],
      "properties": {
        "paper_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
        "title": {"type": "string", "minLength": 8, "maxLength": 300},
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 100}
        },
        "venue": {"type": "string", "minLength": 3, "maxLength": 180},
        "publication_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "publication_details": {"type": "string", "minLength": 4, "maxLength": 300},
        "doi": {"type": ["string", "null"], "pattern": "^10\\.\\d{4,9}/\\S+$"},
        "canonical_record_url": {"$ref": "#/$defs/httpsUrl"},
        "selected_text_version": {"type": "string", "minLength": 12, "maxLength": 300},
        "full_text_url": {"$ref": "#/$defs/httpsUrl"},
        "access_status": {"const": "open_full_text"},
        "license": {"$ref": "#/$defs/license"},
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 80}
        },
        "selection_rationale": {"type": "string", "minLength": 30, "maxLength": 700},
        "scope_limit": {"type": "string", "minLength": 20, "maxLength": 700},
        "checked_at": {"type": "string", "format": "date"}
      }
    },
    "excludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "title", "reason", "source_url"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
        "title": {"type": "string", "minLength": 6, "maxLength": 300},
        "reason": {"type": "string", "minLength": 25, "maxLength": 700},
        "source_url": {"$ref": "#/$defs/httpsUrl"}
      }
    }
  }
}
