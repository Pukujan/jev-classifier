{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/jev-classifier/schemas/context_stimulus_manifest.schema.json",
  "title": "Privacy-safe context stimulus manifest",
  "description": "Synthetic or de-identified context-condition families for controlled benchmark stimuli. Public records must carry no raw private content, no share URLs, no screenshots, and no low-entropy digest of private material; private audit material is referenced only by opaque id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "manifest_id": { "$ref": "#/$defs/id" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "condition_family_id",
        "pair_id",
        "stimulus_method",
        "stimulus_version",
        "seed_provenance",
        "context_size_bucket",
        "source_packet_id",
        "source_packet_version",
        "validation_status"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "condition_family_id": { "$ref": "#/$defs/id" },
        "pair_id": { "$ref": "#/$defs/id" },
        "pair_role": { "enum": ["control", "counterfactual", null] },
        "stimulus_method": {
          "enum": ["synthetic", "deidentified", "paraphrase", "template"]
        },
        "stimulus_version": { "type": "string", "minLength": 1 },
        "seed_provenance": { "type": "string", "minLength": 1 },
        "context_size_bucket": {
          "enum": ["xs", "s", "m", "l", "xl"]
        },
        "source_packet_id": { "$ref": "#/$defs/id" },
        "source_packet_version": { "type": "string", "minLength": 1 },
        "validation_status": {
          "enum": ["unvalidated", "synthetic_reviewed", "privacy_reviewed"]
        },
        "private_audit_ref": {
          "type": ["string", "null"],
          "pattern": "^audit:[A-Za-z0-9_.:-]+$"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
